{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "src/draft.ts",
        "src/host/config.ts",
        "src/host/route.ts",
        "src/shared.ts",
        "tests/**/*.ts"
    ]
}
