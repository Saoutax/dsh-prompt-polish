{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react",
        "resolveJsonModule": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": []
    },
    "include": [
        "src/client/**/*.ts",
        "src/client/**/*.tsx",
        "src/icons.ts",
        "src/draft.ts",
        "src/shared.ts"
    ]
}
